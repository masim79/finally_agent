# Copy this file to .env and fill in what you need. Everything except live AI
# chat works with no keys at all — the app ships with a market simulator and
# a mock chat mode, both fully functional offline.

# Required for live chat ("talk to the AI assistant").
# Get a key at https://openrouter.ai/ — used via LiteLLM -> OpenRouter -> Cerebras.
# Leave blank (or set LLM_MOCK=true below) and the app still runs; chat just
# won't be able to call a real model.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Absent/empty -> the built-in GBM market simulator is used (recommended for
# most users; it's realistic and needs no external account).
# Set it -> the backend polls the real Massive REST API instead.
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic, keyword-driven mock chat
# responses instead of calling OpenRouter. No API key needed in this mode.
# Used by the E2E test suite; also handy for local development without a key.
LLM_MOCK=false

# Advanced: where the SQLite database file lives. The Docker image sets this
# for you (to /app/db/finally.db, inside the persisted volume) — you normally
# don't need to touch it. Only relevant when running the backend directly on
# your host (outside Docker), where it defaults to db/finally.db.
FINALLY_DB_PATH=db/finally.db
